<?xml version="1.0" encoding="UTF-8"?>
<Scene>
    <Camera position="0 0 -6.5" target="0 0 2" up="0 1 0"
            fov="40" near="0.1" far="100"/>
    <Materials>
        <!-- Linear RGB diffuse reflectance. Lambert BRDF = albedo / pi. -->
        <LambertMaterial name="WhiteLambert" albedo="0.8 0.8 0.8"/>
        <LambertMaterial name="RedLambert" albedo="0.8 0.08 0.05"/>
        <LambertMaterial name="GreenLambert" albedo="0.08 0.65 0.12"/>
        <LambertMaterial name="BlueLambert" albedo="0.05 0.15 0.8"/>
        <LambertMaterial name="YellowLambert" albedo="0.85 0.65 0.08"/>
    </Materials>
    <!-- Open-front Cornell box. -->
    <SceneObjects>
        <!-- Floor -->
        <SceneObject material="WhiteLambert">
            <Triangle v0="-2 -2 0" v1="2 -2 4" v2="2 -2 0"/>
            <Triangle v0="-2 -2 0" v1="-2 -2 4" v2="2 -2 4"/>
        </SceneObject>
        <!-- Ceiling -->
        <SceneObject material="WhiteLambert">
            <Triangle v0="-2 2 0" v1="2 2 4" v2="-2 2 4"/>
            <Triangle v0="-2 2 0" v1="2 2 0" v2="2 2 4"/>
        </SceneObject>
        <!-- Left wall -->
        <SceneObject material="RedLambert">
            <Triangle v0="-2 -2 0" v1="-2 2 4" v2="-2 -2 4"/>
            <Triangle v0="-2 -2 0" v1="-2 2 0" v2="-2 2 4"/>
        </SceneObject>
        <!-- Right wall -->
        <SceneObject material="GreenLambert">
            <Triangle v0="2 -2 0" v1="2 2 4" v2="2 2 0"/>
            <Triangle v0="2 -2 0" v1="2 -2 4" v2="2 2 4"/>
        </SceneObject>
        <!-- Back wall -->
        <SceneObject material="WhiteLambert">
            <Triangle v0="-2 -2 4" v1="2 2 4" v2="2 -2 4"/>
            <Triangle v0="-2 -2 4" v1="-2 2 4" v2="2 2 4"/>
        </SceneObject>
        <!-- Three interior objects resting on the floor: two spheres and a rotated box. -->
        <SceneObject position="-0.95 -1.25 1.05" material="BlueLambert">
            <Sphere radius="0.75"/>
        </SceneObject>
        <SceneObject position="0.9 -1.5 0.7" material="YellowLambert">
            <Sphere radius="0.5"/>
        </SceneObject>
        <SceneObject position="0.65 -1.1 2.8" rotation="0 25 0" material="WhiteLambert">
            <Triangle v0="0.55 -0.9 -0.55" v1="-0.55 0.9 -0.55" v2="0.55 0.9 -0.55"/>
            <Triangle v0="0.55 -0.9 -0.55" v1="-0.55 -0.9 -0.55" v2="-0.55 0.9 -0.55"/>
            <Triangle v0="-0.55 0.9 0.55" v1="0.55 -0.9 0.55" v2="0.55 0.9 0.55"/>
            <Triangle v0="-0.55 0.9 0.55" v1="-0.55 -0.9 0.55" v2="0.55 -0.9 0.55"/>
            <Triangle v0="-0.55 0.9 -0.55" v1="-0.55 -0.9 0.55" v2="-0.55 0.9 0.55"/>
            <Triangle v0="-0.55 0.9 -0.55" v1="-0.55 -0.9 -0.55" v2="-0.55 -0.9 0.55"/>
            <Triangle v0="0.55 -0.9 0.55" v1="0.55 0.9 -0.55" v2="0.55 0.9 0.55"/>
            <Triangle v0="0.55 -0.9 0.55" v1="0.55 -0.9 -0.55" v2="0.55 0.9 -0.55"/>
            <Triangle v0="-0.55 -0.9 0.55" v1="0.55 -0.9 -0.55" v2="0.55 -0.9 0.55"/>
            <Triangle v0="-0.55 -0.9 0.55" v1="-0.55 -0.9 -0.55" v2="0.55 -0.9 -0.55"/>
            <Triangle v0="0.55 0.9 -0.55" v1="-0.55 0.9 0.55" v2="0.55 0.9 0.55"/>
            <Triangle v0="0.55 0.9 -0.55" v1="-0.55 0.9 -0.55" v2="-0.55 0.9 0.55"/>
        </SceneObject>
    </SceneObjects>
    <Lights>
        <!-- Attenuations: quadratic linear constant. -->
        <PointLight position="0 1.75 2" intensity="10 10 10" attenuations="1 0 1"/>
    </Lights>
</Scene>
